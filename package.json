{
  "name": "sat-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:pages": "node scripts/build-pages.mjs",
    "db:init": "wrangler d1 execute sat-platform-db --remote --file=schema.sql",
    "test": "node scripts/verify.mjs",
    "check": "node scripts/check.mjs",
    "test:worker": "wrangler deploy --dry-run --outdir dist/worker && node --test tests/worker.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261023.3-beta",
    "wrangler": "4.156.0"
  }
}
